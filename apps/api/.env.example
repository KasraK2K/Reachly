DATABASE_URL=postgresql://reachly:reachly@localhost:5432/reachly
# Shared with apps/web. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_JWT_SECRET=change-me
PORT=4000
# Optional: enables the AI reply assistant (Assistant page). Without it, suggestions return a "not configured" error.
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: the inbox (Instagram API with Instagram Login). From Meta app → Instagram → API setup with Instagram login.
# APP_URL is the public HTTPS address of the web app; Instagram redirects to $APP_URL/api/meta/callback.
# IG_APP_ID=
# IG_APP_SECRET=
# IG_WEBHOOK_VERIFY_TOKEN=any-random-string-you-also-enter-in-meta
# APP_URL=https://your-tunnel.example
