generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadStatus {
  New
  Contacted
  Replied
  Converted
  NotInterested
}

enum CampaignStatus {
  Draft
  Active
  Paused
  Completed
}

enum JobState {
  Queued
  Claimed
  Sent
  Failed
  Skipped
}

enum Role {
  Admin
  Member
}

model User {
  id           String           @id @default(cuid())
  email        String           @unique
  name         String?
  image        String?
  role         Role             @default(Member)
  /// scrypt hash; null = this user can only sign in with Google.
  passwordHash String?
  /// Secret path segment for inbound webhooks (Calendly); null until generated in Settings.
  webhookToken String?          @unique
  /// AI reply assistant setup: { persona, knowledge, goal, objections, handoff }.
  aiSetter     Json?
  createdAt    DateTime         @default(now())
  igAccounts   IgAccount[]
  leads        Lead[]
  templates    Template[]
  campaigns    Campaign[]
  extTokens    ExtensionToken[]
}

model ExtensionToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
}

model IgAccount {
  id                  String         @id @default(cuid())
  userId              String
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  handle              String
  /// Numeric Instagram user id, bound on the first heartbeat from a logged-in browser.
  igUserId            String?
  timezone            String         @default("UTC")
  dailyLimit          Int            @default(30)
  minDelaySec         Int            @default(45)
  maxDelaySec         Int            @default(120)
  quietStart          String         @default("22:00")
  quietEnd            String         @default("07:00")
  pauseOnErrors       Boolean        @default(true)
  pausedReason        String?
  consecutiveFailures Int            @default(0)
  nextSendAt          DateTime?
  lastHeartbeatAt     DateTime?
  extensionVersion    String?
  createdAt           DateTime       @default(now())
  campaigns           Campaign[]
  connection          IgConnection?
  conversations       Conversation[]

  @@unique([userId, handle])
}

model Lead {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  handle        String
  name          String?
  niche         String?
  industry      String?
  followers     Int?
  notes         String?
  /// IANA zone for quiet hours; falls back to the sending account's zone.
  timezone      String?
  status        LeadStatus     @default(New)
  tags          String[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  jobs          SendJob[]
  conversations Conversation[]

  @@unique([userId, handle])
  @@index([userId, status])
}

model Template {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  body      String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  campaigns CampaignTemplate[]
  steps     CampaignStep[]
  jobs      SendJob[]
}

model Campaign {
  id          String             @id @default(cuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  igAccountId String
  igAccount   IgAccount          @relation(fields: [igAccountId], references: [id], onDelete: Cascade)
  name        String
  status      CampaignStatus     @default(Draft)
  createdAt   DateTime           @default(now())
  templates   CampaignTemplate[]
  steps       CampaignStep[]
  jobs        SendJob[]
}

/// Follow-up N (position 1..) goes out `delayDays` after the previous step was sent, unless the lead replied.
model CampaignStep {
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  position   Int
  delayDays  Int
  templateId String
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@id([campaignId, position])
}

model CampaignTemplate {
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  templateId String
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@id([campaignId, templateId])
}

model SendJob {
  id           String    @id @default(cuid())
  campaignId   String
  campaign     Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leadId       String
  lead         Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  templateId   String
  template     Template  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  /// 0 = first message, N = follow-up N.
  step         Int       @default(0)
  renderedText String
  state        JobState  @default(Queued)
  /// Follow-ups only: not handed out before this time. Null = send whenever the account is free.
  dueAt        DateTime?
  attempts     Int       @default(0)
  claimedAt    DateTime?
  sentAt       DateTime?
  error        String?
  createdAt    DateTime  @default(now())

  @@unique([campaignId, leadId, step])
  @@index([state, campaignId])
  @@index([sentAt])
}

/// Failed password sign-ins per email, for lockout. In Postgres so every API instance shares it.
model LoginFailure {
  email   String   @id
  count   Int
  firstAt DateTime
}

/// Official Instagram API login for an account (Instagram Login for Business). Powers the inbox and reply detection.
model IgConnection {
  igAccountId String    @id
  igAccount   IgAccount @relation(fields: [igAccountId], references: [id], onDelete: Cascade)
  /// Professional account id: `entry.id` in webhooks.
  graphUserId String    @unique
  /// App-scoped id; what Meta's deauthorize and data-deletion callbacks send.
  appUserId   String
  username    String
  /// Long-lived token, AES-256-GCM encrypted (see meta.ts). Refreshed before it expires.
  accessToken String
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// A DM thread, created when someone messages a connected account.
model Conversation {
  id            String    @id @default(cuid())
  igAccountId   String
  igAccount     IgAccount @relation(fields: [igAccountId], references: [id], onDelete: Cascade)
  /// The other person's Instagram-scoped id.
  igsid         String
  handle        String?
  name          String?
  leadId        String?
  lead          Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  lastMessageAt DateTime
  /// Their last message; Instagram only allows replies within 24 hours of it.
  lastInboundAt DateTime?
  unread        Boolean   @default(false)
  messages      Message[]

  @@unique([igAccountId, igsid])
  @@index([igAccountId, lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// Instagram message id; dedupes webhook retries and the echo of our own replies.
  mid            String       @unique
  fromMe         Boolean
  text           String
  sentAt         DateTime

  @@index([conversationId, sentAt])
}
